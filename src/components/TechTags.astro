---
interface Props {
  tech: readonly string[];
}

const { tech } = Astro.props;
---

<ul class="tags">
  {
    tech.map((t) => (
      <li class="tag">{t}</li>
    ))
  }
</ul>

<style>
  .tags {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-2);
    background: var(--sunk);
    padding: 2px 7px;
    border-radius: 3px;
    white-space: nowrap;
  }
</style>
