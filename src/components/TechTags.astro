---
/**
 * A tag links only when there is somewhere worth going. 31 of the 36 tech values
 * in the catalogue are used by exactly one project, and a filter page listing one
 * project is a worse destination than the project page the reader already has —
 * so those render as plain text rather than as a link that disappoints.
 *
 * Counts are derived here rather than threaded through CatalogueTable,
 * FeaturedProject and the project page: it is build-time work on a collection of
 * twenty, and it keeps every call site unchanged.
 */
import { getCollection } from 'astro:content';
import { TECH_PAGE_MIN, techHref } from '../lib/taxonomy';

interface Props {
  tech: readonly string[];
}

const { tech } = Astro.props;

const counts = new Map<string, number>();
for (const project of await getCollection('projects')) {
  for (const t of project.data.tech) counts.set(t, (counts.get(t) ?? 0) + 1);
}
const grouped = (t: string) => (counts.get(t) ?? 0) >= TECH_PAGE_MIN;
---

<ul class="tags">
  {
    tech.map((t) =>
      grouped(t) ? (
        <li class="tag">
          <a href={techHref(t)}>{t}</a>
        </li>
      ) : (
        <li class="tag">{t}</li>
      ),
    )
  }
</ul>

<style>
  .tags {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-2);
    background: var(--sunk);
    padding: 2px 7px;
    border-radius: 3px;
    white-space: nowrap;
  }
</style>

<style>
  .tag a {
    color: inherit;
    text-decoration: none;
  }
  .tag a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
