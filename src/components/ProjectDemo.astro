---
/**
 * Resolves a project's `demo.type` to its presentation.
 *
 * This is the seam, not an engine. A `wasm` project maps to its own component
 * under components/demos/ — that component owns its exported C API, its
 * controls and its artifacts. A second WASM demo adds one entry to WASM_DEMOS
 * and one file; it does not generalise this one.
 *
 * Only `wasm` is implemented. media / embed / diagram render nothing yet.
 */
import type { CollectionEntry } from 'astro:content';
import FractolDemo from './demos/FractolDemo.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;

/** Project id -> demo component. Keyed by id so no schema field is needed. */
const WASM_DEMOS = {
  'fract-ol': FractolDemo,
} as const;

const Demo =
  project.data.demo.type === 'wasm'
    ? WASM_DEMOS[project.id as keyof typeof WASM_DEMOS]
    : undefined;
---

{
  Demo && (
    <div id="demo">
      <Demo />
    </div>
  )
}
