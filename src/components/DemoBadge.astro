---
import { DEMO_LABELS, isRunnable, type DemoType } from '../lib/taxonomy';

interface Props {
  type: DemoType;
  label?: string;
}

const { type, label } = Astro.props;
const text = label ?? DEMO_LABELS[type];
const runnable = isRunnable(type);
---

{
  type !== 'none' && (
    <span class:list={['badge', runnable ? 'runnable' : 'neutral', type === 'wasm' && 'solid']}>
      {runnable && (
        <svg viewBox="0 0 10 10" aria-hidden="true">
          <path d="M1 0l8 5-8 5z" />
        </svg>
      )}
      {text}
    </span>
  )
}

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.03em;
    padding: 3px 9px;
    border-radius: 100px;
    white-space: nowrap;
  }

  /* Neutral: readable, never teal. */
  .neutral {
    color: var(--muted);
    border: 1px solid var(--rule);
  }

  /* Runnable: the only place teal appears on project UI. */
  .runnable {
    color: var(--live);
    background: var(--live-soft);
    border: 1px solid var(--live-line);
  }

  .solid {
    background: var(--live);
    color: #fff;
    border-color: var(--live);
    font-weight: 600;
  }

  svg {
    width: 9px;
    height: 9px;
    fill: currentColor;
  }
</style>
