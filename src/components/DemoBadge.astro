---
import { DEMO_LABELS, isRunnable, type DemoType } from '../lib/taxonomy';

interface Props {
  type: DemoType;
  label?: string;
  /**
   * Destination for the badge. Given one, the badge is a real link with hover
   * and focus affordance. Without one it renders as an inert span and must not
   * look clickable — see the .static rules below.
   */
  href?: string;
}

const { type, label, href } = Astro.props;
const text = label ?? DEMO_LABELS[type];
const runnable = isRunnable(type);
const Tag = href ? 'a' : 'span';
---

{
  type !== 'none' && (
    <Tag
      href={href}
      class:list={[
        'badge',
        runnable ? 'runnable' : 'neutral',
        type === 'wasm' && 'solid',
        href ? 'link' : 'static',
      ]}
    >
      {runnable && (
        <svg viewBox="0 0 10 10" aria-hidden="true">
          <path d="M1 0l8 5-8 5z" />
        </svg>
      )}
      {text}
    </Tag>
  )
}

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.03em;
    padding: 3px 9px;
    border-radius: 100px;
    white-space: nowrap;
    text-decoration: none;
  }

  /* Neutral: readable, never teal. */
  .neutral {
    color: var(--muted);
    border: 1px solid var(--rule);
  }

  /* Runnable: the only place teal appears on project UI. */
  .runnable {
    color: var(--live);
    background: var(--live-soft);
    border: 1px solid var(--live-line);
  }

  .solid {
    background: var(--live);
    color: #fff;
    border-color: var(--live);
    font-weight: 600;
  }

  /* Only linked badges get an interactive affordance. */
  .link {
    cursor: pointer;
  }
  .link:hover {
    filter: brightness(1.08);
  }
  .solid.link:hover {
    filter: brightness(1.12);
  }
  .neutral.link:hover {
    color: var(--ink);
    border-color: var(--ink-2);
    filter: none;
  }

  /* Inert badges are labels, not calls to action. */
  .static {
    cursor: default;
  }

  svg {
    width: 9px;
    height: 9px;
    fill: currentColor;
  }
</style>
